# Copy to .env for local development. Keep real secrets out of Git.
APP_TIMEZONE=Asia/Gaza
HOST=127.0.0.1
PORT=8000
# Optional: use a long random value for production deployments.
# TOKEN_SECRET=replace-with-a-long-random-secret
# Optional absolute paths; defaults to ./data/saloon_dreem.db and ./data.
# DATA_DIR=./data
# DATABASE_PATH=./data/saloon_dreem.db
# For cross-origin browser deployments only; comma-separated origins.
# CORS_ORIGINS=https://your-domain.example
